{% extends 'base.html.twig' %}

{% block title %}Inscription{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm auth-card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <h1 class="h3 mb-3 fw-normal">Inscription</h1>
                    <p class="text-muted">Rejoignez l'aventure Pokémon</p>
                </div>

                {{ form_errors(registrationForm) }}

                {{ form_start(registrationForm) }}
                    {{ form_row(registrationForm.email, {
                        attr: { class: 'form-control mb-3' }
                    }) }}
                     {{ form_row(registrationForm.pseudo, {
                        attr: { class: 'form-control mb-3' }
                    }) }}
                    {{ form_row(registrationForm.plainPassword, {
                        label: 'Mot de passe',
                        attr: { class: 'form-control mb-3' }
                    }) }}
                    
                    <div class="mb-3 form-check">
                        {{ form_widget(registrationForm.agreeTerms, { attr: { class: 'form-check-input' } }) }}
                        {{ form_label(registrationForm.agreeTerms, null, { label_attr: { class: 'form-check-label' } }) }}
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">S'inscrire</button>
                    </div>
                {{ form_end(registrationForm) }}
                
                <div class="text-center mt-3">
                     <p class="small text-muted">Déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
