{% extends 'base.html.twig' %}

{% block title %}Liste des Pokémons{% endblock %}

{% block body %}
<div class="row mb-4 align-items-center">
    <div class="col">
        <h1 class="h2 fw-bold mb-0">Pokédex National</h1>
        <p class="text-muted small">{{ pokemons|length }} Pokémons découverts</p>
    </div>
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    {% for pokemon in pokemons %}
        <div class="col">
            <div class="card h-100 shadow-sm hover-up">
                
                {# Placeholder image for now, URL logic comes later #}
                <div class="card-img-top bg-light text-center p-4 d-flex align-items-center justify-content-center" style="height: 200px;">
                    <span class="display-4 text-muted">#{{ pokemon.id }}</span>
                </div>
                
                <div class="card-body">
                    <h5 class="card-title text-capitalize fw-bold mb-1">{{ pokemon.label }}</h5>
                    <p class="card-text text-muted small">No. {{ pokemon.id }}</p>
                    
                     <div class="d-grid mt-3">
                        <a href="#" class="btn btn-outline-primary btn-sm rounded-pill">
                            Voir détails
                        </a>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="col-12">
            <div class="alert alert-info">
                Aucun Pokémon trouvé. Avez-vous lancé l'import ?
            </div>
        </div>
    {% endfor %}
</div>
{% endblock %}
